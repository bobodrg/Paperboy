<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
    <logger name="io.netty" level="WARN" />
    <!-- Rome logs every malformed media tag it skips; those are expected in real feeds. -->
    <logger name="com.rometools" level="ERROR" />
</configuration>
